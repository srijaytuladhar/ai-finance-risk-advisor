# Environment configuration for Fintech Portfolio Risk Advisor
# Active Provider: "fallback" (Gemini -> OpenAI -> Hugging Face), "gemini", "openai", or "huggingface"
LLM_PROVIDER=fallback

# Primary Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Secondary Fallback: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Tertiary Fallback: Hugging Face (Serverless Router)
HUGGINGFACE_API_KEY=hf_...
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct

CHROMA_PATH=./data/chroma
PORT=8000
HOST=0.0.0.0
